# Copy to .env if you want local overrides. No paid API key is required.
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_SYMBOL=EURUSD
DEFAULT_PERIOD=2y
DEFAULT_INTERVAL=1d
RISK_PER_TRADE=0.01
MIN_RISK_REWARD=1.5
MAX_RISK_PER_TRADE=0.02
MAX_DRAWDOWN=0.20
MAX_LEVERAGE=30
INITIAL_CAPITAL=10000
TRANSACTION_COST_PIPS=1.0
SLIPPAGE_PIPS=0.5
MODEL_DIR=models
DATA_DIR=data
